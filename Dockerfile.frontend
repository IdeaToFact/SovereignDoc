# SovereignDoc — Local Air-Gapped Frontend Dockerfile (AGPLv3 Community Edition)
FROM node:22-alpine AS builder

WORKDIR /app/frontend

COPY frontend/package.json frontend/package-lock.json* ./
RUN npm ci

COPY frontend/ ./
RUN npm run build

# Serve the static Vite bundle locally via lightweight preview server with /api proxy
FROM node:22-alpine

LABEL maintainer="Idea To Fact LLC <contact@ideatofact.com>" \
      description="SovereignDoc Community Edition v1.1.0-community - Local-First AI Document Intelligence & Second Brain Frontend" \
      version="1.1.0-community" \
      license="GNU AGPLv3" \
      org.opencontainers.image.title="SovereignDoc Community Edition (Frontend)" \
      org.opencontainers.image.description="Local-First AI Document Intelligence & Second Brain Frontend" \
      org.opencontainers.image.version="1.1.0-community" \
      org.opencontainers.image.licenses="AGPL-3.0-only" \
      org.opencontainers.image.source="https://github.com/ideatofact/sovereigndoc" \
      org.opencontainers.image.vendor="Idea To Fact LLC"

WORKDIR /app/frontend
ENV VITE_API_PROXY_TARGET=http://backend:8000

COPY LICENSE NOTICE THIRD_PARTY_NOTICES.md /usr/local/share/licenses/sovereigndoc/
COPY --from=builder /app/frontend/dist ./dist
COPY --from=builder /app/frontend/package.json ./package.json
COPY --from=builder /app/frontend/vite.config.js ./vite.config.js
COPY --from=builder /app/frontend/node_modules ./node_modules

EXPOSE 5173

CMD ["npx", "vite", "preview", "--host", "0.0.0.0", "--port", "5173"]
